<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <!-- Retained for emulator compatibility -->
        <domain includeSubdomains="true">10.0.2.2</domain>
        <!-- YouTube/Googlevideo CDN for audio streams (often HTTP) -->
        <domain includeSubdomains="true">googlevideo.com</domain>
        <!-- Piped/Invidious subdomains fallback -->
        <domain includeSubdomains="true">piped.mha.fi</domain>
        <domain includeSubdomains="true">vid.priv.au</domain>
    </domain-config>
    
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
