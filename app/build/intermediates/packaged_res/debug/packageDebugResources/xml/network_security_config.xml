<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Base configuration for all connections -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Trust standard system certificates -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    
    <!-- Debug-only configuration -->
    <debug-overrides>
        <trust-anchors>
            <!-- Trust standard system certificates and user-added CAs for debugging -->
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
